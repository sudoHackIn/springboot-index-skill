/bin/zsh -lc "sed -n '1,220p' skills/spring-index/spring-autoconfig-index-lookup/SKILL.md"
/bin/zsh -lc "rg --files skills/spring-index/spring-autoconfig-index-lookup/.eval/scenarios | sed -n '1,160p'"
/bin/zsh -lc "sed -n '1,120p' skills/spring-index/spring-autoconfig-index-lookup/.eval/scenarios/configs/case08-custom-ds-prod-off/application.properties"
/bin/zsh -lc 'test -f skills/spring-index/spring-autoconfig-index-lookup/.eval/scenarios/indexes/skill_eval_fixture_index.json && echo "index: ok" || echo "index: missing"'
/bin/zsh -lc 'test -d skills/spring-index/spring-autoconfig-index-lookup/analyzer/node_modules && echo "analyzer deps: present" || echo "analyzer deps: missing"'
/bin/zsh -lc "sed -n '1,120p' skills/spring-index/spring-autoconfig-index-lookup/.eval/scenarios/configs/case08-custom-ds-prod-off/application-prod.properties"
/bin/zsh -lc 'node skills/spring-index/spring-autoconfig-index-lookup/scripts/diagnose-autoconfig.mjs --question "Ожидается ли fallback на стандартный DataSource?" --bean-regex "dataSource" --property-name "acme.datasource.override.enabled" --config-dir skills/spring-index/spring-autoconfig-index-lookup/.eval/scenarios/configs/case08-custom-ds-prod-off --active-profile prod --index skills/spring-index/spring-autoconfig-index-lookup/.eval/scenarios/indexes/skill_eval_fixture_index.json --debug'
/bin/zsh -lc "jq -r '.autoconfigurations[] | select(.fqcn == \"com.acme.autoconfigure.CustomDataSourceOverrideAutoConfiguration\" or .fqcn == \"org.springframework.boot.autoconfigure.jdbc.DataSourceAutoConfiguration\") | {fqcn, order, class_conditions}' skills/spring-index/spring-autoconfig-index-lookup/.eval/scenarios/indexes/skill_eval_fixture_index.json"
/bin/zsh -lc "jq -r '.autoconfigurations[] | select(any(.class_conditions[]?; .kind == \"OnProperty\" and ((.inputs.name // []) | index(\"acme.datasource.override.enabled\")))) | {fqcn, class_conditions}' skills/spring-index/spring-autoconfig-index-lookup/.eval/scenarios/indexes/skill_eval_fixture_index.json"
/bin/zsh -lc "jq -r '.autoconfigurations[] | .fqcn as "'$cfg | .bean_methods[]? | select((.bean_name // "" | test("dataSource"; "i")) or (.return_type // "" | test("DataSource"; "i"))) | {autoconfig: $cfg, bean_name: .bean_name, return_type: .return_type, conditions: .conditions}'"' skills/spring-index/spring-autoconfig-index-lookup/.eval/scenarios/indexes/skill_eval_fixture_index.json"
