INDEX='skills/spring-index/spring-props-index-lookup/.eval/scenarios/indexes/petclinic_spring_properties_index.json'; jq -r '[.properties[] | select((.name // "") | startswith("spring.datasource."))] | length' "$INDEX"; jq -r '.properties[] | select((.name // "") | startswith("spring.datasource.")) | .name' "$INDEX" | rg '^(spring.datasource.url|spring.datasource.username|spring.datasource.password|spring.datasource.enabled)$' -n; jq -r '.properties[] | select((.name // "") | startswith("spring.datasource.")) | .name' "$INDEX" | rg '^server.port$' -n || true
